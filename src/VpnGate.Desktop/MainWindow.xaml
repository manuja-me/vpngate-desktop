<Window x:Class="VpnGate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="VPN Gate Studio • Desktop Edition" 
        Height="800" Width="1200"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#080C14"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Gradients and Core Brushes -->
        <LinearGradientBrush x:Key="WindowBgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090D16" Offset="0.0"/>
            <GradientStop Color="#0E1626" Offset="0.6"/>
            <GradientStop Color="#060910" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ConnectBtnGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2563EB" Offset="0.0"/>
            <GradientStop Color="#4F46E5" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DisconnectBtnGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DC2626" Offset="0.0"/>
            <GradientStop Color="#B91C1C" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBg" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardHoverBorder" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- Slim ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#334155" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Buttons (Minimize, Maximize, Close) -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Buttons -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ConnectBtnGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#253554"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Styled ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#111827" BorderBrush="#253554" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#253554"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0C1220" BorderThickness="1" BorderBrush="#253554" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Master Window Container with Gradient & Rounded Corners -->
    <Border Background="{StaticResource WindowBgGradient}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/> <!-- Custom Modern Title Bar -->
                <RowDefinition Height="*"/>  <!-- Main Interactive Workspace -->
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- 1. CUSTOM WINDOW TITLEBAR                                 -->
            <!-- ========================================================= -->
            <Border Grid.Row="0" Background="#0A0E18" BorderBrush="#162033" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo & Brand -->
                        <ColumnDefinition Width="*"/>    <!-- Center Navigation Tabs -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Caption Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="7" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="🛡️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="VPN GATE" FontSize="13" FontWeight="ExtraBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="STUDIO" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Navigation View Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="TabBtnServers" Content="🌐  Relay Network" IsChecked="True" Style="{x:Null}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" Cursor="Hand" Click="TabBtnServers_Click"/>
                        <RadioButton x:Name="TabBtnDiagnostics" Content="📋  Diagnostics &amp; Logs" Style="{x:Null}" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="TabBtnDiagnostics_Click"/>
                    </StackPanel>

                    <!-- Right: Engine Pill + Caption Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- OpenVPN Status Pill -->
                        <Border Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEngineIcon" Text="●" Foreground="{StaticResource SuccessGreen}" Margin="0,0,6,0" FontSize="10"/>
                                <TextBlock x:Name="TxtEngineStatus" Text="OpenVPN Ready" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnInstallEngine" Content="Install" Style="{StaticResource PrimaryBtn}" Height="20" Padding="6,1" FontSize="10" Margin="8,0,0,0" Click="BtnInstallEngine_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Minimize, Maximize, Close Buttons -->
                        <Button Content="—" Style="{StaticResource CaptionBtn}" FontSize="10" Click="BtnMinimize_Click"/>
                        <Button Content="▢" Style="{StaticResource CaptionBtn}" FontSize="12" Click="BtnMaximize_Click"/>
                        <Button Content="✕" Style="{StaticResource CaptionCloseBtn}" FontSize="11" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. MAIN WORKSPACE AREA                                    -->
            <!-- ========================================================= -->
            <Grid Grid.Row="1">
                <!-- VIEW A: SERVERS BROWSER & HERO CONNECTION WIDGET -->
                <Grid x:Name="ViewServers" Margin="16,14,16,16" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/> <!-- Left Hero & Filters Column -->
                        <ColumnDefinition Width="*"/>   <!-- Right Server Grid & Stats Column -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: HERO CONNECTION WIDGET & COUNTRY SELECTOR -->
                    <DockPanel Grid.Column="0" Margin="0,0,14,0">
                        <!-- Hero Connection Centerpiece Box -->
                        <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="#253554" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.45" Direction="270" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Status Header & Digital Clock -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtStatusDot" Text="●" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtStatusBadge" Text="Disconnected" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <Border Background="#070B13" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtDuration" Text="00:00:00" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>

                                <!-- Selected Target Node Box -->
                                <Border Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="SELECTED TARGET RELAY" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock x:Name="TxtSelectedTitle" Text="No Server Selected" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtSelectedDetails" Text="Pick any node from the explorer to connect" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hero Action Button (Connect / Disconnect) -->
                                <Button x:Name="BtnConnect" Content="⚡ Connect to Relay" Style="{StaticResource PrimaryBtn}" Height="48" FontSize="15" FontWeight="Bold" IsEnabled="False" Click="BtnConnect_Click" Margin="0,0,0,10">
                                    <Button.Effect>
                                        <DropShadowEffect x:Name="BtnGlowEffect" BlurRadius="20" Color="#2563EB" Opacity="0.45" ShadowDepth="0"/>
                                    </Button.Effect>
                                </Button>

                                <!-- Export Profile Button -->
                                <Button x:Name="BtnExport" Content="📁 Export .OVPN Profile" Style="{StaticResource SecondaryBtn}" Height="32" FontSize="11" IsEnabled="False" Click="BtnExport_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Country Filter Header -->
                        <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                            <TextBlock Text="LOCATIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtCountryCount" Text="0 regions" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Countries Listbox -->
                        <ListBox x:Name="LstCountries" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" SelectionChanged="LstCountries_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#172238"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- RIGHT COLUMN: KPI METRICS + CONTROLS + SERVER CARDS -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- KPI Mini Dashboard -->
                            <RowDefinition Height="Auto"/> <!-- Search & Sort Toolbar -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Server Cards -->
                        </Grid.RowDefinitions>

                        <!-- KPI Dashboard Stats -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ONLINE RELAYS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtStatServers" Text="-- Relays" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="GLOBAL COVERAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtStatCountries" Text="-- Countries" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MAX BANDWIDTH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtStatTopSpeed" Text="-- Mbps" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Search & Sort Controls Toolbar -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>

                            <!-- Modern Search Pill -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#253554" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="0,8,10,8" VerticalAlignment="Center" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Sort Menu -->
                            <ComboBox x:Name="CmbSort" Grid.Column="1" Style="{StaticResource DarkComboBox}" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbSort_SelectionChanged">
                                <ComboBoxItem Content="Highest Speed" IsSelected="True"/>
                                <ComboBoxItem Content="Lowest Ping"/>
                                <ComboBoxItem Content="Most Sessions"/>
                                <ComboBoxItem Content="Score"/>
                            </ComboBox>

                            <!-- Refresh Button -->
                            <Button x:Name="BtnRefresh" Grid.Column="2" Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" Height="36" FontSize="12" Click="BtnRefresh_Click"/>
                        </Grid>

                        <!-- Virtualized Server List -->
                        <ListBox x:Name="LstServers" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="LstServers_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="cardBorder" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                        <Setter TargetName="cardBorder" Property="Background" Value="#172554"/>
                                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="#162238"/>
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#253554"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Flag}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CountryLong}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="28,2,0,0"/>
                                        </StackPanel>

                                        <!-- Right Metric Badges -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#0C1B33" BorderBrush="#1D3E74" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DisplaySpeed}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                            <Border Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="{Binding DisplayPing}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PingColor}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- VIEW B: DIAGNOSTICS & LOGS (FULL SCREEN TERMINAL) -->
                <Grid x:Name="ViewDiagnostics" Margin="16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal Controls Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OpenVPN Tunnel Live Diagnostics" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnClearLogs" Content="Clear Output" Style="{StaticResource SecondaryBtn}" Height="28" Padding="12,2" FontSize="11" Click="BtnClearLogs_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnExportLogs" Content="Copy All" Style="{StaticResource SecondaryBtn}" Height="28" Padding="12,2" FontSize="11" Click="BtnExportLogs_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Terminal Window -->
                    <Border Grid.Row="1" Background="#050811" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12">
                        <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#94A3B8" FontFamily="Consolas, Cascadia Code" FontSize="11" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
