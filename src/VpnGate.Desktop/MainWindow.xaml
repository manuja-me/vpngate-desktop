<Window x:Class="VpnGate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VPN Gate Desktop • Windows 11 Native" 
        Height="780" Width="1160"
        MinHeight="660" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#080C14"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#080C14"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#0D1322"/>
        <SolidColorBrush x:Key="CardBg" Color="#131B2E"/>
        <SolidColorBrush x:Key="CardBgHover" Color="#1A243D"/>
        <SolidColorBrush x:Key="CardBgSelected" Color="#172554"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorderHover" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBlueDark" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- Minimalist Slim ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#334155" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Action Buttons -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Styled ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#131B2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- 1. LEFT SIDEBAR                                           -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="#1A233A" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <!-- App Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2563EB" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="VPN Gate Desktop" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Windows 11 Native • .NET 8" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Engine Status Banner -->
                <Border DockPanel.Dock="Top" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEngineIcon" Text="●" Foreground="{StaticResource WarningAmber}" Margin="0,0,6,0" FontSize="12"/>
                            <TextBlock x:Name="TxtEngineStatus" Text="Checking OpenVPN..." FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnInstallEngine" Content="⚡ Install" Style="{StaticResource PrimaryBtn}" Background="#16A34A" Height="26" Padding="10,2" FontSize="11" HorizontalAlignment="Right" Click="BtnInstallEngine_Click"/>
                    </Grid>
                </Border>

                <!-- Active Connection & Selected Server Card -->
                <Border DockPanel.Dock="Top" Background="#131B2E" BorderBrush="#25334D" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Connection Status Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatusDot" Text="●" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStatusBadge" Text="Disconnected" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <Border Background="#090D16" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtDuration" Text="00:00:00" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>

                        <!-- Selected Server Display Box -->
                        <Border Background="#0D1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtSelectedTitle" Text="No Server Selected" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtSelectedDetails" Text="Select any relay from the list to connect" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Big Connect / Disconnect Action Button -->
                        <Button x:Name="BtnConnect" Content="⚡ Connect" Style="{StaticResource PrimaryBtn}" Height="44" FontSize="14" FontWeight="Bold" IsEnabled="False" Click="BtnConnect_Click" Margin="0,0,0,8"/>

                        <!-- Export Config Button -->
                        <Button x:Name="BtnExport" Content="📁 Export .OVPN Profile" Style="{StaticResource SecondaryBtn}" Height="30" FontSize="11" IsEnabled="False" Click="BtnExport_Click"/>
                    </StackPanel>
                </Border>

                <!-- Location Filter Section -->
                <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                    <TextBlock Text="LOCATIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="TxtCountryCount" Text="0 countries" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                </Grid>

                <ListBox x:Name="LstCountries" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" SelectionChanged="LstCountries_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#172238"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. MAIN CONTENT AREA                                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="20,18,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Stats Mini Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Controls Toolbar -->
                <RowDefinition Height="*"/>    <!-- Server Cards Virtualizing List -->
                <RowDefinition Height="Auto"/> <!-- Bottom Terminal Logs -->
            </Grid.RowDefinitions>

            <!-- Top Stats Mini Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stat 1: Total Relays -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ONLINE RELAYS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtStatServers" Text="-- Servers" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stat 2: Countries -->
                <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="GLOBAL COVERAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtStatCountries" Text="-- Countries" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stat 3: Top Speed -->
                <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PEAK BANDWIDTH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtStatTopSpeed" Text="-- Mbps" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search & Controls Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input with Modern Pill Styling -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="0,8,10,8" VerticalAlignment="Center" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Sort ComboBox -->
                <ComboBox x:Name="CmbSort" Grid.Column="1" Style="{StaticResource DarkComboBox}" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Highest Speed" IsSelected="True"/>
                    <ComboBoxItem Content="Lowest Ping"/>
                    <ComboBoxItem Content="Most Sessions"/>
                    <ComboBoxItem Content="Score"/>
                </ComboBox>

                <!-- Refresh Button -->
                <Button x:Name="BtnRefresh" Grid.Column="2" Content="🔄 Refresh" Style="{StaticResource PrimaryBtn}" Height="36" FontSize="12" Click="BtnRefresh_Click"/>
            </Grid>

            <!-- Server Cards List (Virtualized for smooth 60fps performance) -->
            <ListBox x:Name="LstServers" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="LstServers_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="cardBorder" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                            <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource CardBgSelected}"/>
                                            <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource CardBgHover}"/>
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource CardBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Country Flag, Name, and Details Pill -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Flag}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CountryLong}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="24,3,0,0"/>
                            </StackPanel>

                            <!-- Right: Performance Pill Badges -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Speed Badge -->
                                <Border Background="#0C1B33" BorderBrush="#1D3E74" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DisplaySpeed}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>

                                <!-- Ping Badge -->
                                <Border Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="{Binding DisplayPing}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PingColor}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Collapsible OpenVPN Terminal Logs Drawer -->
            <Border Grid.Row="3" Background="#0C1220" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OpenVPN Tunnel Output" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnClearLogs" Content="Clear" Style="{StaticResource SecondaryBtn}" Height="24" Padding="10,2" FontSize="10" Click="BtnClearLogs_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnToggleLogs" Content="▲ Collapse" Style="{StaticResource SecondaryBtn}" Height="24" Padding="10,2" FontSize="10" Click="BtnToggleLogs_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="TxtLogs" Height="100" Background="#040711" Foreground="#94A3B8" FontFamily="Consolas, Cascadia Code" FontSize="10" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="10,8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
