<Window x:Class="VpnGate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VPN Gate Client (.NET 8 Native)" 
        Height="740" Width="1100"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable Text">

    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT SIDEBAR                               -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <!-- Branding Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="🛡️ VPN Gate Desktop" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="C# .NET 8 Native Edition • Community Relays" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Engine Status Banner -->
                <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock x:Name="TxtEngineStatus" Text="Checking OpenVPN..." FontSize="11" VerticalAlignment="Center" Foreground="#FBBF24"/>
                        <Button x:Name="BtnInstallEngine" Content="⚡ Install" Style="{StaticResource RoundedButton}" Background="#16A34A" Height="24" Padding="8,2" FontSize="11" HorizontalAlignment="Right" Click="BtnInstallEngine_Click"/>
                    </Grid>
                </Border>

                <!-- Connection Control Box -->
                <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Status row -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="TxtStatusBadge" Text="● Disconnected" FontWeight="Bold" FontSize="13" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtDuration" Text="" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Selected Server Details -->
                        <TextBlock x:Name="TxtSelectedTitle" Text="No server selected" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtSelectedDetails" Text="Select a relay from the list to connect" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,12" TextWrapping="Wrap"/>

                        <!-- Big Connect Button -->
                        <Button x:Name="BtnConnect" Content="⚡ Connect" Style="{StaticResource RoundedButton}" Height="40" FontSize="14" FontWeight="Bold" IsEnabled="False" Click="BtnConnect_Click" Margin="0,0,0,6"/>

                        <!-- Export Config Button -->
                        <Button x:Name="BtnExport" Content="📁 Export .OVPN Profile" Style="{StaticResource RoundedButton}" Background="#334155" Height="28" FontSize="11" IsEnabled="False" Click="BtnExport_Click"/>
                    </StackPanel>
                </Border>

                <!-- Country Location Filter -->
                <TextBlock DockPanel.Dock="Top" Text="LOCATION FILTER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                <ListBox x:Name="LstCountries" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" SelectionChanged="LstCountries_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT PANEL                         -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Filter Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Search Entry -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Margin="0,0,10,0">
                    <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,8" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </Border>

                <!-- Sort By Dropdown -->
                <ComboBox x:Name="CmbSort" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Height="34" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Highest Speed" IsSelected="True"/>
                    <ComboBoxItem Content="Lowest Ping"/>
                    <ComboBoxItem Content="Most Sessions"/>
                    <ComboBoxItem Content="Score"/>
                </ComboBox>

                <!-- Refresh Button -->
                <Button x:Name="BtnRefresh" Grid.Column="2" Content="🔄 Refresh" Style="{StaticResource RoundedButton}" Height="34" Click="BtnRefresh_Click"/>
            </Grid>

            <!-- Server Cards List -->
            <ListBox x:Name="LstServers" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LstServers_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="cardBorder" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="Background" Value="#162032"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Flag, Country & Subtitle -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Right: Speed & Ping Badges -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplaySpeed}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DisplayPing}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PingColor}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Collapsible Terminal Log Drawer -->
            <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                <StackPanel>
                    <Grid Margin="10,6">
                        <TextBlock Text="📋 OpenVPN Tunnel Output" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnClearLogs" Content="Clear" Style="{StaticResource RoundedButton}" Background="#334155" Height="22" Padding="8,1" FontSize="10" Click="BtnClearLogs_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnToggleLogs" Content="▲ Collapse" Style="{StaticResource RoundedButton}" Background="#334155" Height="22" Padding="8,1" FontSize="10" Click="BtnToggleLogs_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="TxtLogs" Height="110" Background="#020617" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
