<Window x:Class="VpnGate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="VPN Gate Studio • Monochrome Edition" 
        Height="800" Width="1200"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Pure Monochrome Semantic Brushes -->
        <SolidColorBrush x:Key="BgBlack" Color="#000000"/>
        <SolidColorBrush x:Key="BgSurface" Color="#080808"/>
        <SolidColorBrush x:Key="BgCard" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="BgSelected" Color="#181818"/>
        <SolidColorBrush x:Key="BgHover" Color="#121212"/>
        
        <SolidColorBrush x:Key="BorderHairline" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#333333"/>
        <SolidColorBrush x:Key="BorderWhite" Color="#FFFFFF"/>
        
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A3A3A3"/>
        <SolidColorBrush x:Key="TextMuted" Color="#737373"/>
        <SolidColorBrush x:Key="TextDim" Color="#404040"/>

        <!-- Slim Minimalist ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#262626"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Buttons -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist High-Contrast Buttons -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#525252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inverted Disconnect Button Style (Solid Black with crisp 1px White border and White text) -->
        <Style x:Key="DisconnectBtn" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222222"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#525252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#A3A3A3"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, JetBrains Mono"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1F1F1F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Dark ComboBox -->
        <ControlTemplate x:Key="MinimalComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#000000" BorderBrush="#1F1F1F" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 3 3 L 6 0 Z" Fill="#737373"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#525252"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MinimalComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#1F1F1F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, JetBrains Mono"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource MinimalComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0A0A0A" BorderThickness="1" BorderBrush="#1F1F1F" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#A3A3A3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, JetBrains Mono"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Frame (1px Hairline Border) -->
    <Border Background="{StaticResource BgBlack}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Main Interactive Body -->
                <RowDefinition Height="26"/> <!-- Micro Status Footer -->
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- 1. MINIMALIST TITLEBAR                                    -->
            <!-- ========================================================= -->
            <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Block -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFFFFF" Width="10" Height="10" Margin="0,0,10,0"/>
                        <TextBlock Text="VPN GATE" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Padding="4,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="STUDIO / MONO" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Swiss Monochrome Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="TabBtnServers" Content="RELAYS" IsChecked="True" Style="{x:Null}" Foreground="#000000" Background="#FFFFFF" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code" Padding="10,4" Margin="0,0,2,0" Cursor="Hand" Click="TabBtnServers_Click"/>
                        <RadioButton x:Name="TabBtnDiagnostics" Content="DIAGNOSTICS" Style="{x:Null}" Foreground="{StaticResource TextMuted}" Background="Transparent" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code" Padding="10,4" Cursor="Hand" Click="TabBtnDiagnostics_Click"/>
                    </StackPanel>

                    <!-- Right: Engine Indicator & Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Padding="8,3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEngineIcon" Text="●" Foreground="#FFFFFF" Margin="0,0,6,0" FontSize="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEngineStatus" Text="READY" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnInstallEngine" Content="INSTALL" Style="{StaticResource SecondaryBtn}" Height="18" Padding="4,0" FontSize="9" Margin="6,0,0,0" Click="BtnInstallEngine_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Caption Controls -->
                        <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="—" Style="{StaticResource CaptionBtn}" FontSize="10" Click="BtnMinimize_Click"/>
                                <Border Width="1" Background="{StaticResource BorderHairline}"/>
                                <Button Content="□" Style="{StaticResource CaptionBtn}" FontSize="11" Click="BtnMaximize_Click"/>
                                <Border Width="1" Background="{StaticResource BorderHairline}"/>
                                <Button Content="✕" Style="{StaticResource CaptionCloseBtn}" FontSize="11" Click="BtnClose_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. MAIN WORKSPACE                                         -->
            <!-- ========================================================= -->
            <Grid Grid.Row="1">
                <!-- VIEW A: SERVERS BROWSER -->
                <Grid x:Name="ViewServers" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/> <!-- Left Hero Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Right Server Matrix -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: HERO CONNECTION CENTERPIECE -->
                    <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0" Padding="16">
                        <DockPanel>
                            <!-- Top Section -->
                            <StackPanel DockPanel.Dock="Top">
                                <!-- Status Header -->
                                <Grid Margin="0,0,0,14" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtStatusDot" Text="○" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtStatusBadge" Text="DISCONNECTED" FontFamily="Consolas, Cascadia Code" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Padding="6,2" HorizontalAlignment="Right" Background="#000000">
                                        <TextBlock x:Name="TxtDuration" Text="00:00:00" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>

                                <!-- Selected Target Node Box -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="SELECTED TARGET" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtSelectedTitle" Text="No Server Selected" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtSelectedDetails" Text="Pick any node from the explorer to connect" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <Button x:Name="BtnConnect" Content="⚡ CONNECT TO RELAY" Style="{StaticResource PrimaryBtn}" Height="44" FontSize="12" IsEnabled="False" Click="BtnConnect_Click" Margin="0,0,0,8"/>
                                <Button x:Name="BtnExport" Content="EXPORT .OVPN PROFILE" Style="{StaticResource SecondaryBtn}" Height="30" IsEnabled="False" Click="BtnExport_Click" Margin="0,0,0,16"/>

                                <!-- Location Header -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="REGIONS" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtCountryCount" Text="0 regions" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Bottom Metrics Block -->
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="ONLINE RELAYS" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtStatServers" Text="-- Relays" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="GLOBAL COVERAGE" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtStatCountries" Text="-- Regions" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="MAX BANDWIDTH" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtStatTopSpeed" Text="-- Mbps" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Middle: Countries List -->
                            <ListBox x:Name="LstCountries" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" SelectionChanged="LstCountries_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, JetBrains Mono"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="Foreground" Value="#000000"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#171717"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- RIGHT PANEL: RELAY TABLE & CONTROLS -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Controls Toolbar -->
                            <RowDefinition Height="Auto"/> <!-- Table Header -->
                            <RowDefinition Height="*"/>    <!-- Virtualized Server Matrix -->
                        </Grid.RowDefinitions>

                        <!-- Controls Toolbar -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- Minimalist Search Input -->
                                <Border Grid.Column="0" Background="#000000" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⌕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="0,7,8,7" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas, Cascadia Code" TextChanged="TxtSearch_TextChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Sort Selector -->
                                <ComboBox x:Name="CmbSort" Grid.Column="1" Style="{StaticResource MinimalComboBox}" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbSort_SelectionChanged">
                                    <ComboBoxItem Content="Highest Speed" IsSelected="True"/>
                                    <ComboBoxItem Content="Lowest Ping"/>
                                    <ComboBoxItem Content="Most Sessions"/>
                                    <ComboBoxItem Content="Score"/>
                                </ComboBox>

                                <!-- Refresh -->
                                <Button x:Name="BtnRefresh" Grid.Column="2" Content="↻ REFRESH" Style="{StaticResource SecondaryBtn}" Height="34" Click="BtnRefresh_Click"/>
                            </Grid>
                        </Border>

                        <!-- Minimalist Table Header -->
                        <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1" Padding="16,6">
                            <Grid TextElement.FontFamily="Consolas, Cascadia Code" TextElement.FontSize="9" TextElement.Foreground="{StaticResource TextMuted}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LOCATION / IP ADDRESS"/>
                                <TextBlock Grid.Column="1" Text="BANDWIDTH" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="LATENCY" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="SESSIONS" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="PROTO" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Virtualized Server List -->
                        <ListBox x:Name="LstServers" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                                 SelectionChanged="LstServers_SelectionChanged" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" 
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="10,10"
                                 VirtualizingPanel.CacheLengthUnit="Item">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="cardBorder" Background="#000000" BorderBrush="#141414" BorderThickness="0,0,0,1" Padding="16,9" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource BgSelected}"/>
                                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="2,0,0,1"/>
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource BgHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: Location & IP -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Flag}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CountryLong}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}" Margin="21,2,0,0"/>
                                        </StackPanel>

                                        <!-- Col 1: Bandwidth -->
                                        <TextBlock Grid.Column="1" Text="{Binding DisplaySpeed}" FontSize="11" FontFamily="Consolas, Cascadia Code" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Col 2: Latency -->
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayPing}" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{Binding PingColor}" TextAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Col 3: Sessions -->
                                        <TextBlock Grid.Column="3" Text="{Binding NumVpnSessions}" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Col 4: Proto -->
                                        <Border Grid.Column="4" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,1">
                                            <TextBlock Text="{Binding Proto}" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMuted}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- VIEW B: DIAGNOSTICS LOG TERMINAL -->
                <Grid x:Name="ViewDiagnostics" Visibility="Collapsed" Background="#000000" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" Background="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBlock Text="OPENVPN TUNNEL DIAGNOSTICS &amp; TELEMETRY" FontSize="11" FontFamily="Consolas, Cascadia Code" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnClearLogs" Content="CLEAR" Style="{StaticResource SecondaryBtn}" Height="26" Padding="10,2" Click="BtnClearLogs_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnExportLogs" Content="COPY ALL" Style="{StaticResource SecondaryBtn}" Height="26" Padding="10,2" Click="BtnExportLogs_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#050505" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" Padding="10">
                        <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#A3A3A3" FontFamily="Consolas, Cascadia Code" FontSize="11" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- 3. MINIMALIST STATUS FOOTER                               -->
            <!-- ========================================================= -->
            <Border Grid.Row="2" Background="#000000" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid TextElement.FontFamily="Consolas, Cascadia Code" TextElement.FontSize="9" TextElement.Foreground="{StaticResource TextMuted}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ENGINE: OPENVPN 2.6 • DRIVER: WINTUN • HARDWARE DIRECT3D COMPOSITION" Margin="0,0,16,0"/>
                    </StackPanel>
                    <TextBlock Text="ACADEMIC EXPERIMENT • UNIVERSITY OF TSUKUBA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
